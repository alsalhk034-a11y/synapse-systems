{
  "name": "synapse-systems",
  "private": true,
  "version": "3.0.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc -b && vite build",
    "preview": "vite preview",
    "typecheck": "tsc -b --noEmit",
    "cf:setup": "cd worker && node scripts/setup.mjs",
    "cf:dev": "cd worker && wrangler dev",
    "cf:deploy:worker": "cd worker && npm run deploy",
    "cf:deploy:pages": "wrangler pages deploy dist --project-name synapse-systems-web",
    "cf:deploy": "npm run build && npm run cf:deploy:worker && npm run cf:deploy:pages",
    "cf:tail": "cd worker && wrangler tail",
    "cf:db:shell": "wrangler d1 execute synapse-systems-db --remote --command",
    "cf:db:backup": "wrangler d1 export synapse-systems-db --output=synapse-backup-$(date +%Y%m%d).sql"
  },
  "dependencies": {
    "clsx": "^2.1.1",
    "date-fns": "^4.1.0",
    "framer-motion": "^11.18.0",
    "lucide-react": "^0.469.0",
    "react": "^19.0.0",
    "react-dom": "^19.0.0",
    "react-router-dom": "^7.1.1",
    "tailwind-merge": "^2.6.0",
    "wrangler": "^3.78.0",
    "zustand": "^5.0.2"
  },
  "devDependencies": {
    "@types/node": "^22.10.5",
    "@types/react": "^19.0.2",
    "@types/react-dom": "^19.0.2",
    "@vitejs/plugin-react": "^4.3.4",
    "autoprefixer": "^10.4.20",
    "postcss": "^8.5.1",
    "tailwindcss": "^3.4.17",
    "typescript": "~5.7.2",
    "vite": "^6.0.5"
  }
}
